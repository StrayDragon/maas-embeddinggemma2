# Generated by scripts/gen_env_example.py from config.py -- edit config.py, then regenerate.
# cp .env.example .env   # then set PROFILE; only the active profile's block is read


# --- profile selector -------------------------------------------------
# PROFILE=auto probes torch at startup (GPU present -> strix-halo, else cpu; omlx skips the probe).
# Pin it in .env to skip the probe:
# PROFILE=cpu
# PROFILE=strix-halo
# PROFILE=omlx
PROFILE=auto

# === profile: cpu  (env prefix CPU_*) ===
CPU_MODEL_PATH=models/embeddinggemma-2

CPU_HOST=0.0.0.0

CPU_PORT=50233

CPU_DEVICE=cpu

CPU_DTYPE=float32

CPU_LOG_LEVEL=INFO


# === profile: strix-halo  (env prefix STRIX_HALO_*) ===
STRIX_HALO_MODEL_PATH=models/embeddinggemma-2

STRIX_HALO_HOST=0.0.0.0

STRIX_HALO_PORT=50233

STRIX_HALO_DEVICE=auto

STRIX_HALO_DTYPE=auto

STRIX_HALO_LOG_LEVEL=INFO


# === profile: omlx  (env prefix OMLX_*) ===
OMLX_MODEL_PATH=embeddinggemma-2-bf16

OMLX_HOST=127.0.0.1

OMLX_PORT=50233

OMLX_DEVICE=remote

OMLX_DTYPE=remote

OMLX_LOG_LEVEL=INFO

OMLX_BASE_URL=

OMLX_API_KEY=

OMLX_TIMEOUT_S=120.0
